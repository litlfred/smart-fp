        "summary": "Get enumeration of all ValueSet schemas",
        "description": "Returns a list of all available ValueSet schemas with metadata",
        "responses": {
          "200": {
            "description": "Successfully retrieved valueset enumeration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnumerationResponse"
                },
                "example": {
                  "type": "valueset",
                  "count": 6,
                  "schemas": [
                    {
                      "filename": "ValueSet-breastfeeding-status-values.schema.json",
                      "id": "http://fhir.org/guides/who/fp-cds/ValueSet-breastfeeding-status-values.schema.json",
                      "title": "Breastfeeding status values Schema",
                      "description": "JSON Schema for Breastfeeding status values ValueSet codes. Values are represented as Coding objects with 'system' and 'code' properties.",
